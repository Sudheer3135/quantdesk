# Settings and secrets for QuantDesk's public site, read by caddy.service.
# Copy to /etc/quantdesk/caddy.env (root:root, mode 600) and fill in on the VM.
# This example holds no real value and the filled-in file never enters the
# repository. systemd reads the file literally: no quotes, no `export`, and a
# `$` in the hash is kept as it is.

# The Azure-provided DNS name of the VM's static public IP
# (<label>.<region>.cloudapp.azure.com). The label has not been chosen yet and
# nothing can be deployed until it is. Caddy obtains the certificate for
# exactly this name, and only this origin may open the live websocket.
QUANTDESK_HOSTNAME=REPLACE_WITH_AZURE_DNS_HOSTNAME

# The one owner sign-in. The password is 32 random characters from a password
# manager, used for nothing else. Only its bcrypt hash, cost 14, is stored
# here; README.md has the command, which prompts for the password so that it
# is never typed as an argument or written anywhere on the VM.
QUANTDESK_BASIC_USER=owner
QUANTDESK_BASIC_HASH=REPLACE_WITH_BCRYPT_COST_14_HASH

# The API's own key (API_KEY in the project's .env), added by the proxy to
# the websocket request it forwards. install.sh copies it from .env without
# displaying it. It never reaches the browser.
QUANTDESK_API_KEY=REPLACE_WITH_API_KEY_FROM_PROJECT_ENV

# Only for the trial issuance that comes before the real certificate
# (README.md, "Hostname and certificate"). `staging` is the only value there
# is besides the default: Let's Encrypt's staging directory, kept in a storage
# directory of its own. Without the line, Let's Encrypt production and
# production's storage. Remove it again afterwards: a staging certificate is
# not one a browser trusts.
#QUANTDESK_CERTIFICATES=staging
