# First conditional shutdown attempt at 17:30 IST on weekdays, then every 15
# minutes until 21:00. Not Persistent: a missed attempt is not made late; the
# Azure monitor at 21:30 reports a VM that is still running.
#
# NOT INSTALLED. Disabled template.
[Unit]
Description=QuantDesk power: shutdown-evaluation requests, weekdays 17:30-21:00 IST

[Timer]
OnCalendar=Mon..Fri *-*-* 17:30,45:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 18..20:00,15,30,45:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 21:00:00 Asia/Kolkata
AccuracySec=1s
Persistent=false
Unit=quantdesk-power-request.service

[Install]
WantedBy=timers.target
