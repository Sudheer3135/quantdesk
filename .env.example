# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://quant:quant@postgres:5432/quantdesk
REDIS_URL=redis://redis:6379/0

# mock = simulated data, no network needed. Start here.
# free = real NIFTY data from Yahoo + NSE. No account, no fee. See docs/FREE_DATA.md
# kite = live Zerodha data. Paid subscription.
BROKER=mock

# Store every fetched candle in Postgres so your own history grows past the
# 60-day cap that free sources impose. Leave this on.
ARCHIVE_CANDLES=true

# Capture an option-chain snapshot on every agent tick. This is the ONLY way
# option history ever comes to exist: NSE publishes a live snapshot, not a
# tape, and nobody sells the history at a retail price. A bar not captured
# today cannot be recovered tomorrow.
ARCHIVE_OPTION_CHAIN=true
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Leave false. Turning this on lets the platform send real orders.
LIVE_TRADING=false

CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_TRADES_PER_DAY=2
MIN_RISK_REWARD=2.0
LOT_SIZE=65

AGENT_INTERVAL_MINUTES=5
WATCH_SYMBOL=NIFTY
WATCH_TIMEFRAME=5m

# Shared key for the endpoints that write to the database (imports,
# backtests, journal, persisted signals) and for the live websocket.
# Leave blank for localhost-only use; REQUIRED when ENVIRONMENT=prod.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Interface the containers publish on. Loopback by default; set to 0.0.0.0
# only if you intend the desk to be reachable from other machines.
BIND_HOST=127.0.0.1

CORS_ORIGINS=http://localhost:5173

# DNS forwarders for the backend container (see docker-compose.yml).
#
# Docker's embedded resolver otherwise forwards to whatever the host's
# resolv.conf points at, which on a laptop is a moving target — a VPN, a
# captive portal, a resolver that has gone away. When that resolver stops
# answering, outbound calls hang rather than fail, and a hung call holds a
# scheduler slot until its job's next run is skipped. Override these if your
# network requires an internal resolver.
DNS_SERVER_1=1.1.1.1
DNS_SERVER_2=8.8.8.8

# ---- Angel One SmartAPI (live price feed only) ------------------------
#
# When enabled, the live NIFTY price comes from Angel's SmartWebSocketV2
# push feed instead of the five-second poll. Nothing else moves: candles,
# the option chain, signals, regime, bias, entry state, risk and every
# backtest still run exactly as they did, from BROKER above.
#
# If any of these is missing, or the feed goes quiet for ANGEL_STALE_SECONDS,
# the desk falls back to the polled source automatically and says so at
# GET /health/feed. There is no configuration in which a missing Angel
# credential stops the application from starting.
#
# These are read by the backend only. Nothing serialises them and no API
# response carries them — the browser never sees an Angel credential.
ANGEL_ENABLED=false
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# MPIN on newer accounts, the login password on older ones. Set whichever
# your account uses; ANGEL_MPIN wins if both are present.
ANGEL_MPIN=
ANGEL_PASSWORD=
# The base32 secret from Angel's "Enable TOTP" page — not a six-digit code.
# A code expires in thirty seconds; the secret is what generates them.
ANGEL_TOTP_SECRET=

# NIFTY 50 on NSE cash, from Angel's instrument master. Verify it before
# trusting it: a wrong token subscribes the desk to a different instrument
# and every price is simply somebody else's.
ANGEL_NIFTY_TOKEN=99926000
ANGEL_EXCHANGE_TYPE=1

# A push feed proves it is alive by pushing. Past this with no tick, the
# feed is treated as down and the poller takes over.
ANGEL_STALE_SECONDS=10

# Floor between two published prices, in milliseconds. Not a poll interval —
# it caps how often a burst of ticks reaches Redis and every open browser.
ANGEL_MIN_PUBLISH_MS=250

# ---- Angel live option chain ------------------------------------------
#
# Off by default. When on, the option chain is assembled from SNAP_QUOTE
# ticks on the same websocket as the price — roughly 400ms behind the
# exchange instead of the polled chain's 60 seconds, and it costs NSE
# nothing. The poller keeps running as the fallback; nothing about signals,
# regime, bias, entry state, risk or the backtests changes.
ANGEL_OPTIONS_ENABLED=false

# Strikes either side of spot to subscribe. NIFTY strikes are 50 apart, so
# 20 is ±1000 points and about 82 contracts.
ANGEL_OPTIONS_BAND=20

# Re-centre when fewer than this many strikes of cover remain on one side.
ANGEL_OPTIONS_REFRESH_MARGIN=5

# A contract with nothing newer than this is dropped from the chain rather
# than reported. Far strikes legitimately go quiet for long stretches.
ANGEL_OPTIONS_MAX_AGE_SECONDS=900

# Consecutive quiet checks before the poller takes over from the stream.
# At 1 the source flips on a single late tick and flips back on the next
# one, which shows on the dashboard as fluctuation. At 2 a switch needs the
# feed to be silent across two whole poll cycles.
ANGEL_FALLBACK_CONFIRMATIONS=2
